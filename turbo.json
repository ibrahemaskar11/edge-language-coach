{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DIRECT_URL", "DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "passThroughEnv": ["DIRECT_URL", "DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": ["DIRECT_URL", "DATABASE_URL", "SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY"]
    }
  }
}

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres   ## Same as DATABASE_URL but with the username in the format postgres.[project-ref] instead of just postgres. This is required for some Supabase features like Edge Functions.
VITE_SUPABASE_URL=https://your-project.supabase.co ## Same as SUPABASE_URL but prefixed with VITE_. This is required for the frontend to access these variables.
VITE_SUPABASE_ANON_KEY=your-anon-key ## Same as SUPABASE_ANON_KEY but prefixed with VITE_. This is required for the frontend to access these variables.

# Groq
GROQ_API_KEY=your-groq-api-key
# Optional: point the gateway at a mock Groq server (e.g. for the circuit breaker demo).
# When set, the Groq SDK uses this as its base URL instead of api.groq.com.
# GROQ_BASE_URL=http://localhost:8080
# When running the gateway in Docker compose against a host-side mock, use:
# GROQ_BASE_URL=http://host.docker.internal:8080

# Demo mode — exposes /api/breaker-demo/chat (no auth, no rate-limit).
# DO NOT enable in production. Used only for the circuit-breaker live demo.
# DEMO_MODE=1

# Gateway
PORT=3001

# MCP / Admin
# Secret key for the /admin/breakers/reset endpoint — used by remediation-mcp.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=your-admin-api-key
# Override the gateway/workers URL for MCP servers (defaults to localhost)
# GATEWAY_URL=http://localhost:3001
# WORKERS_URL=http://localhost:3002
